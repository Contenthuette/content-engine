# Copy to .env (never commit). install.sh creates it for you.
CLIPPERZ_API=https://loyal-finch-512.eu-west-1.convex.site/clipperz
# openssl rand -hex 32 ; Convex setting worker_secret_sha256 = sha256 hex of this value
CLIPPERZ_WORKER_SECRET=
# stable name per server (crash recovery: hello fails the jobs still marked running under this name)
CLIPPERZ_WORKER_NAME=render-1
# heavy = clip + style, light = edit
CLIPPERZ_HEAVY_SLOTS=1
CLIPPERZ_LIGHT_SLOTS=1
CLIPPERZ_BUDGET_MIN=900
# renders at once inside one clip job (8 cores: 2 – one render left ~45 % of the CPU idle)
CLIPPERZ_RENDER_PARALLEL=2
